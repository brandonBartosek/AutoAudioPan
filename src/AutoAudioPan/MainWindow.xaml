<ui:FluentWindow x:Class="AutoAudioPan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AutoAudioPan" Icon="pack://application:,,,/Assets/app.ico" Width="760" Height="640" MinWidth="620" MinHeight="400"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AutoAudioPan" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,12">
            <StackPanel>
                <TextBlock Text="Sound apps" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                           Text="Auto pans each app to where its window sits across your monitors." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="ShowHiddenToggle" Content="Show hidden apps" Margin="0,0,12,0"
                                 Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed" />
                <ui:ToggleSwitch x:Name="AutostartToggle" Content="Start with Windows" Margin="0,0,8,0"
                                 Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
                    <StackPanel>
                    <Grid>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,80,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="16"
                           Text="No sound apps have played during this session." />
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Summary}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Content="Rename" Margin="16,0,0,0" Padding="8,2" Click="RenameGroup_Click" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Children}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
<Border Margin="0,0,0,8" Padding="16" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
<Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsIdle}" Value="True"><Setter Property="Opacity" Value="0.7" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Move to group..." Click="MoveToGroup_Click" /><MenuItem Header="Reset to app group" Click="ResetGroup_Click" /></ContextMenu></Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" Margin="12,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:ToggleSwitch Grid.Column="2" Content="Hide row"
                                                             IsChecked="{Binding Hidden, Mode=TwoWay}"
                                                             Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton Content="Auto" GroupName="{Binding RootPid}" IsChecked="{Binding IsAuto}" Margin="0,0,12,0" />
                                            <RadioButton Content="Manual" GroupName="{Binding RootPid}" IsChecked="{Binding IsManual}" Margin="0,0,12,0" />
                                            <RadioButton Content="Off" GroupName="{Binding RootPid}" IsChecked="{Binding IsOff}" />
                                        </StackPanel>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Pan" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.5" TickPlacement="BottomRight"
                                                    IsEnabled="{Binding PanEnabled}"
                                                    Value="{Binding EffectivePan, Mode=OneWay}"
                                                    ValueChanged="PanSlider_ValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding EffectivePan, StringFormat={}{0:+0.00;-0.00;C}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Volume" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <ui:ToggleSwitch Grid.Column="3" Content="Mute" IsChecked="{Binding Muted, Mode=TwoWay}" Margin="16,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Expander Header="Known sound apps (pre-registered so first sounds aren't clipped)" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="KnownInput" Width="240" ToolTip="Executable name, e.g. app.exe" />
                        <ui:Button Content="Add" Margin="8,0,0,0" Click="AddKnown_Click" />
                        <ui:Button Content="Remove selected" Margin="8,0,0,0" Click="RemoveKnown_Click" />
                    </StackPanel>
                    <ListBox x:Name="KnownList" MaxHeight="220" DisplayMemberPath="Exe" />
                </StackPanel>
            </Expander>
            <Expander Header="Experimental head tracking" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Camera tracking is opt-in and processed locally. If the camera is unavailable or no face is detected, normal window panning remains the fallback."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:ToggleSwitch x:Name="HeadTrackingToggle" Content="Enable head-yaw correction"
                                         Checked="HeadTracking_Changed" Unchecked="HeadTracking_Changed" />
                        <TextBlock x:Name="HeadTrackingStatus" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="HeadTrackingDetails" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ui:Button Content="Calibrate neutral" Margin="0,8,0,0" HorizontalAlignment="Left"
                               Click="HeadTrackingCalibrate_Click" />
                </StackPanel>
            </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
